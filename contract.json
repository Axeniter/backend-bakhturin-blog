{
  "base_url": "http://localhost:8000",
  "resource": "posts",
  "id_field": "id",
  "missing_id": "999999",
  "list_key": null,
  "create": { "title": "My first post!","content": "XD", "author": "Alex", "is_published": true },
  "update": { "content": "hahaha"},
  "required_field": "title",
  "errors": [
    { "body": { "title": ""}, "field": "title" },
    { "body": { "content": ""}, "field": "content" },
    { "body": { "author": ""}, "field": "author" },
    { "body": { "is_published": null}, "field": "is_published"}
  ],
  "filter": { "param": "author", "value": "Alex", "other": "Ivan" }

  "text_field": "title",
  "search": { "param": "q", "field": "title" },
  "child": {
    "resource": "comments",
      "create": { "text": "XD", "author": "Dima" },
      "parent_field": "post_id"
  },
  "rule": {
    "description": "You can't comment unpublished post",
    "parent": { "is_published": false },
    "setup": [],
    "violate": {
      "method": "POST",
      "path": "/api/posts/{id}/comments",
      "body": { "text": "hi", "author": "Max" }
    },
    "expect_status": 409
  },
  "stats_path": "/api/posts/stats"
}
